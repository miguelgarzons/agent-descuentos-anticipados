# ══════════════════════════════════════════════════════════════
# Descuentos Anticipados — CUN ADK Agent — plantilla de variables
# ══════════════════════════════════════════════════════════════
#
#   cp .env.example .env      y completa con los valores reales.
#
# El .env REAL nunca se commitea (lo bloquea .gitignore y un gate del CI).
# En Cloud Run estas mismas variables se inyectan desde
# Settings → Environments (main/develop) → Variables, vía --set-env-vars
# en .github/workflows/deploy.yml.
#
# Los valores de abajo son PLACEHOLDERS. Los únicos literales reales son URLs
# públicas de QA, que no son secretos.
# ══════════════════════════════════════════════════════════════


# ── Entorno ──────────────────────────────────────────────────
# Etiqueta del entorno: dev | prod. La setea el CI según la rama
# (develop → dev, main → prod). En local déjala en dev.
ENVIRONMENT=dev


# ── Modelo LLM ───────────────────────────────────────────────
# Modelo Gemini que usan los subagentes con LLM. Acepta "gemini-2.5-pro" o "gemini/gemini-2.5-pro".
AGENT_MODEL=gemini-2.5-pro

# API key de Google Gemini. Sin esto ningún LlmAgent arranca.
GEMINI_API_KEY=tu-api-key-de-gemini


# ── Zoho Desk vía MCP (lectura y escritura del ticket) ───────
# URL del servidor MCP de Zoho. Solo funciona desde el runtime autorizado
# (Cloud Run); desde una máquina de desarrollo devuelve HTTP 400
# "Invalid server domain" — no es un bug del código.
ZOHO_MCP_URL=https://<tu-tenant>.zohomcp.com/mcp/<token>/message

# ID de la organización en Zoho Desk (va en el header orgId de cada llamada).
ZOHO_ORG_ID=000000000

# Headers extra para el MCP, en JSON. Opcional; normalmente vacío.
# ZOHO_MCP_HEADERS={"X-Custom":"valor"}


# ── Zoho Desk REST (descarga de adjuntos) ────────────────────
# Webhook que emite el token OAuth para la API REST de Desk. Sin estas tres
# variables el lector de documentos no puede descargar los soportes del ticket.
ZOHO_TOKEN_WEBHOOK_URL=https://<tu-webhook>/token
ZOHO_TOKEN_WEBHOOK_USER=usuario-webhook
ZOHO_TOKEN_WEBHOOK_PASS="password-webhook"

# Base de la API REST de Desk del sandbox (los threads y adjuntos se leen de aquí).
ZOHO_DESK_API_BASE_SANDBOX=https://desk.zoho.com/api/v1


# ── Comportamiento del emisor ────────────────────────────────
# Agente humano al que se reasigna el ticket cuando queda para revisión manual.
ZOHO_ASSIGNEE_AGENT_ID=000000000000000000

# Dirección "from" del correo saliente. En el portal sandbox no hay from-address
# válida, por eso la respuesta al estudiante se publica como comentario público.
# ZOHO_FROM_EMAIL=cartera@cun.edu.co
# ZOHO_REPLY_FROM_EMAIL=cartera@cun.edu.co

# Estado al que se mueve el ticket al cerrarlo (default: Cerrado).
# ZOHO_CLOSE_STATUS=Cerrado

# Interruptores de cada acción sobre el ticket. Ausente o "true" = habilitada.
# En local conviene apagar el envío de correo: con estas variables en true el
# agente escribe de verdad en Zoho.
ZOHO_REPLY_ENABLED=false
ZOHO_PUBLIC_REPLY_ENABLED=true
ZOHO_CLOSE_TICKET_ENABLED=true

# Comentario interno con el resumen del pipeline. Ausente o "true" = habilitado.
ZOHO_COMMENT_ENABLED=true

# ── Firma institucional del correo (pie de las plantillas) ───
# RAÍZ del host de assets, SIN barra final. El emisor le concatena las rutas
#   /Logos/CUN/Normal/Logo%20Color/CUN40A%C3%B1os.svg   (logo de los 40 años)
#   /Firma%20correos/pie_de_correo.png                  (banner del pie)
# Con barra final el host responde 403 a la doble barra y las dos imágenes del
# correo quedan rotas (el emisor la recorta, pero mejor no ponerla).
ASSETS_FAB=https://assetsfab.cunapp.pro
WATERMARK_PRYMARY_MAME=Nombre Apellido
WATERMARK_PRYMARY_AREA=Cartera
WATERMARK_PRYMARY_VICE=Vicerrectoría Administrativa y Financiera
WATERMARK_WEB=https://www.cun.edu.co


# ── Idempotencia (Firestore) ─────────────────────────────────
# Pub/Sub entrega at-least-once y el pipeline escribe en Zoho y, más adelante, en sistemas externos:
# un lock por ticket_id en Firestore garantiza un solo procesamiento.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_COLLECTION=descuentos_anticipados_idempotency

# Segundos tras los cuales un lock "processing" se considera stale (crash previo)
# y el ticket puede reprocesarse. Default: 900.
# IDEMPOTENCY_LOCK_TTL_SECONDS=900

# Proyecto GCP y base Firestore con nombre. En este proyecto NO existe la base
# "(default)": hay una por entorno, así que hay que fijarla explícitamente.
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
FIRESTORE_DATABASE=categorizador-dev
